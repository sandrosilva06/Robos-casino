# Copia para .env e preenche. O .env nunca vai para o git.

# --- Telegram (cria os bots no @BotFather; o chat é o ID do canal/grupo) ---
TELEGRAM_TOKEN_FS=
TELEGRAM_CHAT_FS=
TELEGRAM_TOKEN_LR=
TELEGRAM_CHAT_LR=
# Opcional: link da mesa no casino, aparece na mensagem de entrada
LINK_MESA_FS=https://betnjet.click/WFcUQ
LINK_MESA_LR=

ATIVAR_FOOTBALL_STUDIO=true
ATIVAR_LIGHTNING_ROULETTE=true

# --- Fonte dos resultados: tipminer | simulador ---
FONTE=tipminer
SIMULADOR_INTERVALO=5

# --- Tipminer (confirma URLs e seletores com: python main.py --diagnostico) ---
TIPMINER_EMAIL=
TIPMINER_SENHA=
TIPMINER_URL_LOGIN=https://www.tipminer.com/br/login
TIPMINER_SELETOR_EMAIL=input[type="email"]
TIPMINER_SELETOR_SENHA=input[type="password"]
TIPMINER_SELETOR_ENTRAR=button[type="submit"]
TIPMINER_URL_FOOTBALL_STUDIO=https://www.tipminer.com/br/historico/evolution/football-studio
TIPMINER_URL_LIGHTNING_ROULETTE=https://www.tipminer.com/br/historico/evolution/lightning-roulette
TIPMINER_SELETOR_RESULTADO=.cell
TIPMINER_RECENTE_PRIMEIRO=true
TIPMINER_INTERVALO=4
# false abre o browser visível (útil para ver o que se passa)
TIPMINER_HEADLESS=true

# --- Estratégia ---
# Tamanhos dos padrões analisados (últimas N cores)
PADRAO_TAMANHOS=3,4,5
# Mínimo de vezes que o padrão tem de ter aparecido no histórico
MIN_AMOSTRAS=20
# Taxa mínima de green (até ao G2) desse padrão no histórico
TAXA_MINIMA=0.88
# Taxa máxima: padrões acima disto são ignorados
TAXA_MAXIMA=0.98
MAX_GALES=2

# --- Gestão ---
MULTIPLICADOR_GALE=2
# Aposta na proteção = fração da aposta na cor (0.1 = 10%)
FRACAO_PROTECAO=0.1
# Rondas sem sinais depois de um red
PAUSA_APOS_RED=3

# --- Casino (ler os resultados diretamente da mesa) ---
CASINO_EMAIL=
CASINO_SENHA=
CASINO_URL_LOGIN=https://www.bettilt746.com/pt/casino
# URL da mesa (abre a mesa no browser e copia o endereço)
CASINO_URL_FS=
CASINO_URL_LR=
CASINO_HEADLESS=true
